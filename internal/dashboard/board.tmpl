<p class="checked">{{.Checked}}</p>
<section class="summary" aria-label="Filter devices">
  <button type="button" class="card" data-filter="all" aria-pressed="false"><strong>{{.Total}}</strong><span>Devices</span></button>
  <button type="button" class="card healthy" data-filter="healthy" aria-pressed="false"><strong>{{.Healthy}}</strong><span>Healthy</span></button>
  <button type="button" class="card attention" data-filter="attention" aria-pressed="false"><strong>{{.Attention}}</strong><span>Needs attention</span></button>
  <button type="button" class="card unknown" data-filter="unknown" aria-pressed="false"><strong>{{.Unknown}}</strong><span>Unknown</span></button>
  <article class="card"><strong>{{.Stored}}</strong><span>Stored logs</span></article>
  {{if .ShowAdoption}}
  <button type="button" class="card{{if .CandidateAlert}} attention{{end}}" data-view="candidates" aria-pressed="false"><strong>{{.CandidateCount}}</strong><span>Not in inventory</span></button>
  <button type="button" class="card ignored" data-view="ignored" aria-pressed="false"><strong>{{.IgnoredCount}}</strong><span>Ignored</span></button>
  {{end}}
</section>
<p class="note">{{.SizeNote}}</p>
{{if .ShowAdoption}}
<section id="adoption" class="adoption" data-view-panel="candidates" hidden data-revision="{{.Revision}}" aria-label="Untracked sources">
  <h2>Not in the inventory</h2>
  <p class="note">Each card is one directory, or one loose file. When a directory has more than one log file, choose which one to monitor. Adopt adds that file to the inventory. Ignore hides every log file on the card.</p>
  {{if .DiscoverNote}}<p class="note bad">{{.DiscoverNote}}</p>{{end}}
  {{if .Candidates}}
  <div class="adopt-list">
    {{range .Candidates}}
    <article class="adopt-card" data-path="{{.Path}}" data-source-ip="{{.Source}}" data-ip-locked="{{if .IPLocked}}true{{else}}false{{end}}">
      <div>
        <div class="device">{{.Name}}</div>
        <div class="path" title="{{if .Choose}}{{.Dir}}{{else}}{{.Path}}{{end}}">{{if .Choose}}{{.Dir}}{{else}}{{.Path}}{{end}}</div>
        <div class="meta">{{.Detail}}</div>
      </div>
      <div class="adopt-fields">
        {{if .Choose}}
        <label>Log file
          <select data-field="logfile">
            {{range .Files}}
            <option value="{{.Path}}" data-meta="{{.Meta}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>
            {{end}}
          </select>
        </label>
        {{end}}
        <label>Name <input data-field="name" value="{{.Name}}" autocomplete="off" spellcheck="false" maxlength="128"></label>
        <label>Source IP {{if .IPLocked}}<input data-field="source" value="{{.Source}}" readonly>{{else}}<input data-field="source" value="" placeholder="192.0.2.10" autocomplete="off" spellcheck="false">{{end}}</label>
        <label>Protocol
          <select data-field="protocol">
            <option value="udp" selected>UDP</option>
            <option value="tcp">TCP</option>
          </select>
        </label>
        <label>TCP port <input data-field="port" type="number" min="1" max="65535" inputmode="numeric" placeholder="default"></label>
        <div class="meta" data-file-meta>{{.FileMeta}}</div>
      </div>
      <div class="actions">
        <button type="button" class="action" data-action="adopt">Adopt</button>
        <button type="button" class="quiet" data-action="ignore">Ignore</button>
      </div>
    </article>
    {{end}}
  </div>
  {{else if not .DiscoverNote}}
  <p class="note">No untracked files in the watched directories.</p>
  {{end}}
</section>
<section id="ignored-panel" class="adoption" data-view-panel="ignored" hidden aria-label="Ignored sources">
  <h2>Ignored</h2>
  <p class="note">These files stay out of the inventory and are not monitored. Stop ignoring returns a file to Not in inventory when it is still in a watched directory.</p>
  {{if .Ignored}}
  <div class="adopt-list">
    {{range .Ignored}}
    <article class="ignore-card" data-path="{{.Path}}">
      <div>
        <div class="path" title="{{.Path}}">{{.Path}}</div>
        {{if .Source}}<div class="meta">{{.Source}}</div>{{end}}
      </div>
      <div class="actions">
        <button type="button" class="quiet" data-action="unignore">Stop ignoring</button>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <p class="note">Nothing is ignored.</p>
  {{end}}
</section>
{{end}}
<div id="device-board" class="table-wrap">
<table>
<caption>Expected syslog sources. Select a device for its status and the files in its log directory. Problems are listed first.</caption>
<thead>
<tr>
<th scope="col">Device</th>
<th scope="col">Source</th>
<th scope="col">Reporting</th>
<th scope="col">Connection</th>
<th scope="col">Last write</th>
<th scope="col">Active file</th>
<th scope="col">Stored logs</th>
<th scope="col">Overall</th>
</tr>
</thead>
<tbody>
{{range .Rows}}
<tr class="row {{.StatusClass}}" data-status="{{.StatusClass}}" data-search="{{.Search}}" data-source="{{.Source}}" tabindex="0" aria-label="Show details for {{.Name}}">
<td><div class="device">{{.Name}}</div><div class="path" title="{{.Path}}">{{.Path}}</div></td>
<td><div class="mono">{{.Source}}</div><div class="meta">{{.Transport}}</div></td>
<td><div>{{.LogLabel}}</div><div class="meta">{{.LogDetail}}</div></td>
<td>{{.ConnDetail}}</td>
<td class="mono"><div>{{.LastTime}}</div>{{if .LastDay}}<div class="meta">{{.LastDay}}</div>{{end}}</td>
<td><div class="num" title="{{.ActiveTitle}}">{{.Active}}</div></td>
<td><div class="num" title="{{.StoredTitle}}">{{.Stored}}</div><div class="meta">{{.StoredDetail}}</div></td>
<td><span class="pill {{.StatusClass}}">{{.StatusLabel}}</span></td>
</tr>
{{else}}
<tr><td colspan="8">No devices are loaded.</td></tr>
{{end}}
<tr id="filter-empty" hidden><td colspan="8">No devices match this search or filter.</td></tr>
</tbody>
</table>
</div>
