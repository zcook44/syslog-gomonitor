<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Syslog source monitor</title>
<style>
  :root {
    color-scheme: light;
    --bg: #e7edf3;
    --ink: #152033;
    --muted: #526173;
    --card: #ffffff;
    --line: #d3dde7;
    --head: #e8eef5;
    --healthy-bg: #e3f6ea;
    --healthy-fg: #0f6a40;
    --attention-bg: #fde7e2;
    --attention-fg: #8a2d1c;
    --unknown-bg: #fff4d4;
    --unknown-fg: #6a4e00;
    --accent: #1d4e79;
    --shadow: 0 1px 2px rgba(20, 32, 51, .05);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #101820;
      --ink: #e7eef5;
      --muted: #a8b6c6;
      --card: #1a242f;
      --line: #2d3d4d;
      --head: #223140;
      --healthy-bg: #123226;
      --healthy-fg: #9ee0b8;
      --attention-bg: #3c211c;
      --attention-fg: #ffb5a6;
      --unknown-bg: #3a3114;
      --unknown-fg: #f3d98a;
      --accent: #9dc4ea;
      --shadow: none;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.45 system-ui, sans-serif;
  }
  header, main, footer { width: min(1280px, calc(100% - 2rem)); margin: 0 auto; }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 1.5rem 0 1rem; }
  h1 { margin: 0 0 .25rem; font-size: 1.6rem; letter-spacing: -.02em; }
  .sub, .note, .meta, caption, footer, .path { color: var(--muted); }
  .sub { margin: 0; max-width: 46rem; }
  .live { display: inline-flex; align-items: center; gap: .45rem; margin: .2rem 0 0; font-weight: 650; }
  .dot { width: .7rem; height: .7rem; border-radius: 99px; background: var(--healthy-fg); box-shadow: 0 0 0 0 var(--healthy-fg); animation: pulse 1.8s ease-out infinite; }
  .live.bad .dot { background: var(--attention-fg); animation: none; box-shadow: none; }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  .checked { margin: 0 0 .8rem; font-variant-numeric: tabular-nums; }
  .summary { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: .9rem; }
  .toolbar { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: flex-end; margin-bottom: .85rem; }
  .search { display: flex; flex-direction: column; gap: .25rem; flex: 1 1 18rem; max-width: 32rem; }
  .search span, .match-count { color: var(--muted); font-size: .82rem; }
  .match-count { margin: 0 0 .15rem; min-height: 1.1rem; }
  .search input {
    width: 100%; font: inherit; color: var(--ink); background: var(--card);
    border: 1px solid var(--line); border-radius: .55rem; padding: .55rem .7rem;
  }
  .search input:focus-visible, button.card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card {
    background: var(--card); border: 1px solid var(--line); border-radius: .7rem;
    min-width: 8.2rem; padding: .75rem .95rem; box-shadow: var(--shadow);
  }
  button.card { font: inherit; color: inherit; text-align: left; cursor: pointer; }
  button.card:hover { border-color: var(--accent); }
  button.card.selected { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .card strong { display: block; font-size: 1.45rem; font-variant-numeric: tabular-nums; }
  .card.healthy strong { color: var(--healthy-fg); }
  .card.attention strong { color: var(--attention-fg); }
  .card.unknown strong { color: var(--unknown-fg); }
  .card.ignored strong { color: var(--muted); }
  .note { margin: 0 0 .9rem; }
  .table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: .8rem; box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; }
  caption { caption-side: bottom; text-align: left; padding: .75rem .9rem 1rem; }
  th, td { padding: .7rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--head); font-size: .82rem; letter-spacing: .02em; white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  .row.attention td:first-child { box-shadow: inset 3px 0 0 var(--attention-fg); }
  .row.unknown td:first-child { box-shadow: inset 3px 0 0 var(--unknown-fg); }
  .row.healthy td:first-child { box-shadow: inset 3px 0 0 var(--healthy-fg); }
  .device { font-weight: 700; }
  .path, .mono { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .82rem; }
  .mono, .num { white-space: nowrap; }
  .path { display: block; max-width: 16rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { margin-top: .15rem; white-space: normal; max-width: 18rem; }
  .num { font-variant-numeric: tabular-nums; font-weight: 650; }
  .pill { display: inline-block; border-radius: 99px; padding: .15rem .6rem; font-weight: 700; white-space: nowrap; }
  .pill.healthy { background: var(--healthy-bg); color: var(--healthy-fg); }
  .pill.attention { background: var(--attention-bg); color: var(--attention-fg); }
  .pill.unknown { background: var(--unknown-bg); color: var(--unknown-fg); }
  .note.bad { color: var(--attention-fg); }
  .adoption { margin: 0 0 1.1rem; }
  .adoption h2, .adoption h3 { margin: 0 0 .35rem; font-size: 1.15rem; }
  .adoption h3 { margin-top: 1rem; font-size: 1rem; }
  .adopt-list { display: flex; flex-direction: column; gap: .75rem; }
  .adopt-card, .ignore-card {
    background: var(--card); border: 1px solid var(--line); border-radius: .8rem;
    padding: .85rem .95rem; box-shadow: var(--shadow);
  }
  .adopt-fields { display: flex; flex-wrap: wrap; gap: .6rem .75rem; align-items: flex-end; margin-top: .7rem; }
  .adopt-fields label { display: flex; flex-direction: column; gap: .2rem; font-size: .82rem; color: var(--muted); }
  .adopt-fields input, .adopt-fields select {
    font: inherit; color: var(--ink); background: var(--bg);
    border: 1px solid var(--line); border-radius: .45rem; padding: .4rem .55rem; min-width: 10rem;
  }
  .adopt-fields input:focus-visible, .adopt-fields select:focus-visible,
  button.action:focus-visible, button.quiet:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  button.action, button.quiet {
    font: inherit; font-weight: 650; border-radius: .5rem; padding: .45rem .8rem; cursor: pointer;
  }
  button.action { background: var(--accent); color: var(--bg); border: 0; }
  button.quiet { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  button.action:disabled, button.quiet:disabled { cursor: default; opacity: .6; }
  footer { padding: 1rem 0 2rem; }
  footer p { margin: 0; }
</style>
</head>
<body data-overdue-after="{{.OverdueAfter}}" data-generated-at="{{.GeneratedAt}}">
<header>
  <div>
    <h1>Syslog source monitor</h1>
    <p class="sub">Devices expected to report to this server. Activity is checked continuously. Stored log size is measured on an hourly pass.</p>
  </div>
  <p id="live" class="live" role="status"><span class="dot" aria-hidden="true"></span><span id="live-text">Live</span></p>
</header>
<main>
  <div class="toolbar">
    <label class="search">
      <span>Search devices</span>
      <input id="device-search" type="search" placeholder="Name, address, or log path" autocomplete="off" spellcheck="false">
    </label>
    <p id="match-count" class="match-count" aria-live="polite"></p>
  </div>
  <div id="board">{{.Board}}</div>
  <p id="action-status" class="note" role="status"></p>
</main>
<footer>
  <p>A device is healthy when its own log file was written within its silence limit. TCP devices also need an established session to the configured port. UDP has no connection to check. The active file size is the current log. Stored logs add rotated files in the same directory and are not recounted on every status check. Log contents are never read or shown.</p>
</footer>
<noscript><p class="note">Automatic updates need JavaScript. Reload the page for a newer check.</p></noscript>
<script>
(function () {
  var live = document.getElementById("live");
  var liveText = document.getElementById("live-text");
  var board = document.getElementById("board");
  var search = document.getElementById("device-search");
  var matchCount = document.getElementById("match-count");
  var link = "up";
  var statusFilter = "";
  var view = "";
  var actionStatus = document.getElementById("action-status");
  var busy = false;

  function setPressed(cards, selected) {
    for (var c = 0; c < cards.length; c++) {
      var on = selected(cards[c]);
      cards[c].classList.toggle("selected", on);
      cards[c].setAttribute("aria-pressed", on ? "true" : "false");
    }
  }

  function applyFilters() {
    var query = (search && search.value || "").trim().toLowerCase();
    var showDevices = view === "";
    var deviceBoard = document.getElementById("device-board");
    var candidates = board.querySelector("[data-view-panel='candidates']");
    var ignored = board.querySelector("[data-view-panel='ignored']");
    if (deviceBoard) deviceBoard.hidden = !showDevices;
    if (candidates) candidates.hidden = view !== "candidates";
    if (ignored) ignored.hidden = view !== "ignored";
    var rows = board.querySelectorAll("tbody tr.row");
    var shown = 0;
    for (var i = 0; i < rows.length; i++) {
      var row = rows[i];
      var status = row.getAttribute("data-status") || "";
      var haystack = row.getAttribute("data-search") || "";
      var visible = showDevices && (statusFilter === "" || status === statusFilter) &&
        (query === "" || haystack.indexOf(query) !== -1);
      row.hidden = !visible;
      if (visible) shown++;
    }
    var empty = document.getElementById("filter-empty");
    if (empty) empty.hidden = !showDevices || rows.length === 0 || shown !== 0;
    setPressed(board.querySelectorAll("[data-filter]"), function (card) {
      return showDevices && statusFilter !== "" && card.getAttribute("data-filter") === statusFilter;
    });
    setPressed(board.querySelectorAll("[data-view]"), function (card) {
      return card.getAttribute("data-view") === view;
    });
    if (matchCount) {
      if (!showDevices || (query === "" && statusFilter === "")) matchCount.textContent = "";
      else matchCount.textContent = "Showing " + shown + " of " + rows.length;
    }
  }

  function refreshLive() {
    var at = Date.parse(document.body.getAttribute("data-generated-at") || "");
    var overdue = Number(document.body.getAttribute("data-overdue-after")) * 1000;
    if (!at || Date.now() - at > overdue) {
      live.className = "live bad";
      liveText.textContent = "Monitor overdue — status may be out of date";
      return;
    }
    if (link !== "up") {
      live.className = "live bad";
      liveText.textContent = "Reconnecting…";
      return;
    }
    live.className = "live";
    liveText.textContent = "Live";
  }

  function adoptionDirty(root) {
    if (!root) return false;
    if (root.contains(document.activeElement)) return true;
    var fields = root.querySelectorAll("input, select");
    for (var i = 0; i < fields.length; i++) {
      var input = fields[i];
      if (input.tagName === "SELECT") {
        var chosen = input.options[input.selectedIndex];
        if (chosen && !chosen.defaultSelected) return true;
        continue;
      }
      if (input.value !== input.defaultValue) return true;
    }
    return false;
  }

  function setAction(text, bad) {
    if (!actionStatus) return;
    actionStatus.textContent = text || "";
    actionStatus.className = bad ? "note bad" : "note";
  }

  function postJSON(url, body) {
    return fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Requested-With": "syslog-gomonitor"
      },
      body: JSON.stringify(body)
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (!res.ok) throw new Error((data && data.error) || "The inventory could not be updated.");
        return data;
      });
    });
  }

  function field(card, name) {
    var el = card.querySelector('[data-field="' + name + '"]');
    return el ? el.value.trim() : "";
  }

  function runAction(btn) {
    if (busy) return;
    var card = btn.closest("[data-path]");
    if (!card) return;
    var action = btn.getAttribute("data-action");
    var logPath = card.getAttribute("data-path") || "";
    var body = { log_path: logPath };
    var url = "/api/ignore";
    var done = "Ignored this file.";
    if (action === "unignore") {
      url = "/api/unignore";
      done = "This file can be adopted again.";
    } else if (action === "adopt") {
      var name = field(card, "name");
      if (!name) {
        setAction("Enter a device name before adopting.", true);
        return;
      }
      var locked = card.getAttribute("data-ip-locked") === "true";
      var source = locked ? (card.getAttribute("data-source-ip") || "") : field(card, "source");
      if (!locked && !source) {
        setAction("Enter the source IP address before adopting.", true);
        return;
      }
      var protocol = field(card, "protocol") || "udp";
      body = { name: name, source_ip: source, protocol: protocol, log_path: logPath };
      var port = field(card, "port");
      if (protocol === "tcp" && port) body.tcp_port = Number(port);
      url = "/api/adopt";
      done = "Adopted " + name + ".";
    }
    busy = true;
    btn.disabled = true;
    setAction("Saving…", false);
    postJSON(url, body).then(function () {
      setAction(done, false);
    }).catch(function (err) {
      setAction(err.message || "The inventory could not be updated.", true);
    }).then(function () {
      busy = false;
      if (btn.isConnected) btn.disabled = false;
    });
  }

  function apply(msg) {
    if (!msg || typeof msg.html !== "string") {
      return;
    }
    var adoption = document.getElementById("adoption");
    var keep = adoptionDirty(adoption) ? adoption : null;
    var rev = keep ? keep.getAttribute("data-revision") : "";
    board.innerHTML = msg.html;
    if (keep) {
      var next = document.getElementById("adoption");
      if (next && next.getAttribute("data-revision") === rev) next.replaceWith(keep);
    }
    if (msg.generated_at) {
      document.body.setAttribute("data-generated-at", msg.generated_at);
    }
    link = "up";
    refreshLive();
    applyFilters();
  }

  board.addEventListener("click", function (ev) {
    var action = ev.target.closest("[data-action]");
    if (action && board.contains(action)) {
      runAction(action);
      return;
    }
    var viewCard = ev.target.closest("[data-view]");
    if (viewCard && board.contains(viewCard)) {
      var chosen = viewCard.getAttribute("data-view");
      if (chosen === view) view = "";
      else {
        view = chosen;
        statusFilter = "";
      }
      applyFilters();
      return;
    }
    var card = ev.target.closest("[data-filter]");
    if (!card || !board.contains(card)) return;
    view = "";
    var next = card.getAttribute("data-filter");
    if (next === "all" || next === statusFilter) statusFilter = "";
    else statusFilter = next;
    applyFilters();
  });
  if (search) search.addEventListener("input", applyFilters);

  function connect() {
    if (!window.EventSource) {
      link = "down";
      refreshLive();
      return;
    }
    var source = new EventSource("/events");
    source.onmessage = function (ev) {
      try {
        apply(JSON.parse(ev.data));
      } catch (err) {
        link = "down";
        live.className = "live bad";
        liveText.textContent = "Status update was unreadable";
      }
    };
    source.onerror = function () {
      link = "down";
      refreshLive();
    };
  }

  refreshLive();
  applyFilters();
  setInterval(refreshLive, 5000);
  connect();
})();
</script>
</body>
</html>
