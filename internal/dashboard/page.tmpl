<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>Syslog source monitor</title>
<style>
  :root {
    color-scheme: light;
    --bg: #e7edf3;
    --ink: #152033;
    --muted: #526173;
    --card: #ffffff;
    --line: #d3dde7;
    --head: #e8eef5;
    --healthy-bg: #e3f6ea;
    --healthy-fg: #0f6a40;
    --attention-bg: #fde7e2;
    --attention-fg: #8a2d1c;
    --unknown-bg: #fff4d4;
    --unknown-fg: #6a4e00;
    --accent: #1d4e79;
    --shadow: 0 1px 2px rgba(20, 32, 51, .05);
  }
  html[data-theme="dark"] {
    color-scheme: dark;
    --bg: #101820;
    --ink: #e7eef5;
    --muted: #a8b6c6;
    --card: #1a242f;
    --line: #2d3d4d;
    --head: #223140;
    --healthy-bg: #123226;
    --healthy-fg: #9ee0b8;
    --attention-bg: #3c211c;
    --attention-fg: #ffb5a6;
    --unknown-bg: #3a3114;
    --unknown-fg: #f3d98a;
    --accent: #9dc4ea;
    --shadow: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #101820;
      --ink: #e7eef5;
      --muted: #a8b6c6;
      --card: #1a242f;
      --line: #2d3d4d;
      --head: #223140;
      --healthy-bg: #123226;
      --healthy-fg: #9ee0b8;
      --attention-bg: #3c211c;
      --attention-fg: #ffb5a6;
      --unknown-bg: #3a3114;
      --unknown-fg: #f3d98a;
      --accent: #9dc4ea;
      --shadow: none;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.45 system-ui, sans-serif;
  }
  header, main, footer { width: min(1280px, calc(100% - 2rem)); margin: 0 auto; }
  header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 1.5rem 0 1rem; }
  .header-side { display: flex; flex-direction: column; align-items: flex-end; gap: .65rem; }
  .theme-switch { display: inline-flex; border: 1px solid var(--line); border-radius: .55rem; overflow: hidden; }
  .theme-switch button {
    font: inherit; font-weight: 650; color: var(--ink); background: var(--card);
    border: 0; padding: .4rem .75rem; cursor: pointer;
  }
  .theme-switch button[aria-pressed="true"] { background: var(--accent); color: var(--bg); }
  #back-to-top {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 2;
    font: inherit; font-weight: 650; color: var(--bg); background: var(--accent);
    border: 0; border-radius: .55rem; padding: .55rem .85rem; cursor: pointer;
  }
  #back-to-top[hidden] { display: none; }
  h1 { margin: 0 0 .25rem; font-size: 1.6rem; letter-spacing: -.02em; }
  .sub, .note, .meta, caption, footer, .path { color: var(--muted); }
  .sub { margin: 0; max-width: 46rem; }
  .live { display: inline-flex; align-items: center; gap: .45rem; margin: .2rem 0 0; font-weight: 650; }
  .dot { width: .7rem; height: .7rem; border-radius: 99px; background: var(--healthy-fg); box-shadow: 0 0 0 0 var(--healthy-fg); animation: pulse 1.8s ease-out infinite; }
  .live.bad .dot { background: var(--attention-fg); animation: none; box-shadow: none; }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 8px transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  .checked { margin: 0 0 .8rem; font-variant-numeric: tabular-nums; }
  .summary { display: flex; flex-wrap: wrap; gap: .75rem; margin-bottom: .9rem; }
  .toolbar { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: flex-end; margin-bottom: .85rem; }
  .search { display: flex; flex-direction: column; gap: .25rem; flex: 1 1 18rem; max-width: 32rem; }
  .search span, .match-count { color: var(--muted); font-size: .82rem; }
  .match-count { margin: 0 0 .15rem; min-height: 1.1rem; }
  .search input {
    width: 100%; font: inherit; color: var(--ink); background: var(--card);
    border: 1px solid var(--line); border-radius: .55rem; padding: .55rem .7rem;
  }
  .search input:focus-visible, button.card:focus-visible,
  .theme-switch button:focus-visible, #back-to-top:focus-visible,
  tr.row:focus-visible, #device-detail button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card {
    background: var(--card); border: 1px solid var(--line); border-radius: .7rem;
    min-width: 8.2rem; padding: .75rem .95rem; box-shadow: var(--shadow);
  }
  button.card { font: inherit; color: inherit; text-align: left; cursor: pointer; }
  button.card:hover { border-color: var(--accent); }
  button.card.selected { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .card strong { display: block; font-size: 1.45rem; font-variant-numeric: tabular-nums; }
  .card.healthy strong { color: var(--healthy-fg); }
  .card.attention strong { color: var(--attention-fg); }
  .card.unknown strong { color: var(--unknown-fg); }
  .card.ignored strong { color: var(--muted); }
  .note { margin: 0 0 .9rem; }
  .table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--line); border-radius: .8rem; box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; }
  caption { caption-side: bottom; text-align: left; padding: .75rem .9rem 1rem; }
  th, td { padding: .7rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  th { background: var(--head); font-size: .82rem; letter-spacing: .02em; white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  tr.row { cursor: pointer; }
  tr.row:hover td { background: var(--head); }
  .row.attention td:first-child { box-shadow: inset 3px 0 0 var(--attention-fg); }
  .row.unknown td:first-child { box-shadow: inset 3px 0 0 var(--unknown-fg); }
  .row.healthy td:first-child { box-shadow: inset 3px 0 0 var(--healthy-fg); }
  .device { font-weight: 700; }
  .path, .mono { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .82rem; }
  .mono, .num { white-space: nowrap; }
  .path { display: block; max-width: 16rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { margin-top: .15rem; white-space: normal; max-width: 18rem; }
  .num { font-variant-numeric: tabular-nums; font-weight: 650; }
  .pill { display: inline-block; border-radius: 99px; padding: .15rem .6rem; font-weight: 700; white-space: nowrap; }
  .pill.healthy { background: var(--healthy-bg); color: var(--healthy-fg); }
  .pill.attention { background: var(--attention-bg); color: var(--attention-fg); }
  .pill.unknown { background: var(--unknown-bg); color: var(--unknown-fg); }
  .note.bad { color: var(--attention-fg); }
  .adoption { margin: 0 0 1.1rem; }
  .adoption h2, .adoption h3 { margin: 0 0 .35rem; font-size: 1.15rem; }
  .adoption h3 { margin-top: 1rem; font-size: 1rem; }
  .adopt-list { display: flex; flex-direction: column; gap: .75rem; }
  .adopt-card, .ignore-card {
    background: var(--card); border: 1px solid var(--line); border-radius: .8rem;
    padding: .85rem .95rem; box-shadow: var(--shadow);
  }
  .adopt-card.result-adopted, .ignore-card.result-adopted {
    border: 3px solid var(--healthy-fg);
    box-shadow: 0 0 0 3px var(--healthy-fg);
  }
  .adopt-card.result-ignored, .ignore-card.result-ignored {
    border: 3px solid var(--unknown-fg);
    box-shadow: 0 0 0 3px var(--unknown-fg);
  }
  .adopt-card.result-error, .ignore-card.result-error {
    border: 3px solid var(--attention-fg);
    box-shadow: 0 0 0 3px var(--attention-fg);
  }
  .choice-note { margin: 0 0 .55rem; font-weight: 700; }
  .result-adopted .choice-note { color: var(--healthy-fg); }
  .result-ignored .choice-note { color: var(--unknown-fg); }
  .result-error .choice-note { color: var(--attention-fg); }
  .adopt-fields input.invalid, .adopt-fields select.invalid { border-color: var(--attention-fg); }
  .adopt-fields { display: flex; flex-wrap: wrap; gap: .6rem .75rem; align-items: flex-end; margin-top: .7rem; }
  .adopt-fields label { display: flex; flex-direction: column; gap: .2rem; font-size: .82rem; color: var(--muted); }
  .adopt-fields input, .adopt-fields select {
    font: inherit; color: var(--ink); background: var(--bg);
    border: 1px solid var(--line); border-radius: .45rem; padding: .4rem .55rem; min-width: 10rem;
  }
  .adopt-fields input:focus-visible, .adopt-fields select:focus-visible,
  button.action:focus-visible, button.quiet:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  button.action, button.quiet {
    font: inherit; font-weight: 650; border-radius: .5rem; padding: .45rem .8rem; cursor: pointer;
  }
  button.action { background: var(--accent); color: var(--bg); border: 0; }
  button.quiet { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  button.action:disabled, button.quiet:disabled { cursor: default; opacity: .6; }
  #device-detail {
    width: min(46rem, calc(100vw - 2rem)); max-height: min(86vh, 44rem);
    border: 1px solid var(--line); border-radius: .9rem; padding: 0;
    background: var(--card); color: var(--ink); box-shadow: 0 18px 50px rgba(16, 24, 32, .28);
  }
  #device-detail::backdrop { background: rgba(16, 24, 32, .45); }
  .detail-head { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding: 1rem 1rem .25rem; }
  .detail-head h2 { margin: 0; font-size: 1.25rem; }
  .detail-body { padding: 0 1rem 1rem; overflow: auto; max-height: calc(86vh - 4.5rem); }
  .detail-grid { display: grid; grid-template-columns: 8.5rem 1fr; gap: .35rem .75rem; margin: .4rem 0 1rem; }
  .detail-grid dt { color: var(--muted); }
  .detail-grid dd { margin: 0; }
  .detail-files { width: 100%; border-collapse: collapse; margin-top: .4rem; }
  .detail-files th, .detail-files td { padding: .45rem .4rem; }
  .detail-files .path { max-width: none; white-space: normal; overflow: visible; text-overflow: clip; }
  .kind { font-size: .78rem; font-weight: 700; color: var(--muted); }
  .kind.active { color: var(--healthy-fg); }
  .kind.series, .kind.rotation { color: var(--accent); }
  footer { padding: 1rem 0 2rem; }
  footer p { margin: 0; }
</style>
<script>
(function () {
  var theme = null;
  try { theme = localStorage.getItem("syslog-gomonitor-theme"); } catch (err) {}
  if (theme !== "light" && theme !== "dark") {
    document.documentElement.removeAttribute("data-theme");
    return;
  }
  document.documentElement.setAttribute("data-theme", theme);
})();
</script>
</head>
<body data-overdue-after="{{.OverdueAfter}}" data-generated-at="{{.GeneratedAt}}">
<header>
  <div>
    <h1>Syslog source monitor</h1>
    <p class="sub">Devices expected to report to this server. Activity is checked continuously. Stored log size is measured on an hourly pass.</p>
  </div>
  <div class="header-side">
    <div class="theme-switch" role="group" aria-label="Color theme">
      <button type="button" id="theme-browser" aria-pressed="true">Browser</button>
      <button type="button" id="theme-light" aria-pressed="false">Light</button>
      <button type="button" id="theme-dark" aria-pressed="false">Dark</button>
    </div>
    <p id="live" class="live" role="status"><span class="dot" aria-hidden="true"></span><span id="live-text">Live</span></p>
  </div>
</header>
<main>
  <div class="toolbar">
    <label class="search">
      <span>Search devices</span>
      <input id="device-search" type="search" placeholder="Name, address, or log path" autocomplete="off" spellcheck="false">
    </label>
    <p id="match-count" class="match-count" aria-live="polite"></p>
  </div>
  <div id="board">{{.Board}}</div>
  <p id="action-status" class="note" role="status"></p>
</main>
<dialog id="device-detail" aria-labelledby="detail-title">
  <div class="detail-head">
    <h2 id="detail-title">Device</h2>
    <button type="button" class="quiet" id="detail-close">Close</button>
  </div>
  <div id="detail-body" class="detail-body"></div>
</dialog>
<footer>
  <p>A device is healthy when its own log file was written within its silence limit. TCP devices also need an established session to the configured port. UDP has no connection to check. The active file size is the current log. Stored logs add rotated files in the same directory and are not recounted on every status check. Log contents are never read or shown.</p>
</footer>
<button type="button" id="back-to-top" hidden>Back to top</button>
<noscript><p class="note">Automatic updates need JavaScript. Reload the page for a newer check.</p></noscript>
<script>
(function () {
  var live = document.getElementById("live");
  var liveText = document.getElementById("live-text");
  var board = document.getElementById("board");
  var detail = document.getElementById("device-detail");
  var detailTitle = document.getElementById("detail-title");
  var detailBody = document.getElementById("detail-body");
  var detailClose = document.getElementById("detail-close");
  var openSource = "";
  var detailToken = 0;
  var detailLoadedAt = 0;
  var search = document.getElementById("device-search");
  var matchCount = document.getElementById("match-count");
  var link = "up";
  var statusFilter = "";
  var view = "";
  var latestMsg = null;
  var retired = {};
  var actionStatus = document.getElementById("action-status");
  var busy = false;

  function setPressed(cards, selected) {
    for (var c = 0; c < cards.length; c++) {
      var on = selected(cards[c]);
      cards[c].classList.toggle("selected", on);
      cards[c].setAttribute("aria-pressed", on ? "true" : "false");
    }
  }

  function applyFilters() {
    var query = (search && search.value || "").trim().toLowerCase();
    var showDevices = view === "";
    var deviceBoard = document.getElementById("device-board");
    var candidates = board.querySelector("[data-view-panel='candidates']");
    var ignored = board.querySelector("[data-view-panel='ignored']");
    if (deviceBoard) deviceBoard.hidden = !showDevices;
    if (candidates) candidates.hidden = view !== "candidates";
    if (ignored) ignored.hidden = view !== "ignored";
    var rows = board.querySelectorAll("tbody tr.row");
    var shown = 0;
    for (var i = 0; i < rows.length; i++) {
      var row = rows[i];
      var status = row.getAttribute("data-status") || "";
      var haystack = row.getAttribute("data-search") || "";
      var visible = showDevices && (statusFilter === "" || status === statusFilter) &&
        (query === "" || haystack.indexOf(query) !== -1);
      row.hidden = !visible;
      if (visible) shown++;
    }
    var empty = document.getElementById("filter-empty");
    if (empty) empty.hidden = !showDevices || rows.length === 0 || shown !== 0;
    setPressed(board.querySelectorAll("[data-filter]"), function (card) {
      return showDevices && statusFilter !== "" && card.getAttribute("data-filter") === statusFilter;
    });
    setPressed(board.querySelectorAll("[data-view]"), function (card) {
      return card.getAttribute("data-view") === view;
    });
    if (matchCount) {
      if (!showDevices || (query === "" && statusFilter === "")) matchCount.textContent = "";
      else matchCount.textContent = "Showing " + shown + " of " + rows.length;
    }
  }

  function refreshLive() {
    var at = Date.parse(document.body.getAttribute("data-generated-at") || "");
    var overdue = Number(document.body.getAttribute("data-overdue-after")) * 1000;
    if (!at || Date.now() - at > overdue) {
      live.className = "live bad";
      liveText.textContent = "Monitor overdue — status may be out of date";
      return;
    }
    if (link !== "up") {
      live.className = "live bad";
      liveText.textContent = "Reconnecting…";
      return;
    }
    live.className = "live";
    liveText.textContent = "Live";
  }

  function panelSelector(name) {
    return "[data-view-panel='" + name + "']";
  }

  function fieldCaret() {
    var el = document.activeElement;
    if (!el || !board.contains(el) || !el.closest("[data-view-panel]")) return null;
    var start = null;
    var end = null;
    if (typeof el.selectionStart === "number") {
      start = el.selectionStart;
      end = el.selectionEnd;
    }
    return { el: el, start: start, end: end };
  }

  function restoreCaret(saved) {
    if (!saved || !saved.el || !board.contains(saved.el)) return;
    saved.el.focus();
    if (saved.start === null || !saved.el.setSelectionRange) return;
    try {
      saved.el.setSelectionRange(saved.start, saved.end);
    } catch (err) {}
  }

  // Live updates must not rebuild the list the operator is filling in.
  // The device table and summary counts still refresh. The open list is
  // replaced only after the operator returns to the device table.
  function installBoard(html, preservePanel) {
    var caret = fieldCaret();
    var wrap = document.createElement("div");
    wrap.innerHTML = html;
    if (preservePanel === "candidates" || preservePanel === "ignored") {
      var current = board.querySelector(panelSelector(preservePanel));
      var incoming = wrap.querySelector(panelSelector(preservePanel));
      if (current && incoming) incoming.replaceWith(current);
    }
    dropRetired(wrap);
    while (board.firstChild) board.removeChild(board.firstChild);
    while (wrap.firstChild) board.appendChild(wrap.firstChild);
    dropRetired(board);
    restoreCaret(caret);
  }

  function removeCard(card) {
    var list = card.parentNode;
    if (!list) return;
    list.removeChild(card);
    if (list.querySelector("[data-path]")) return;
    var note = document.createElement("p");
    note.className = "note";
    note.textContent = list.closest("[data-view-panel='ignored']")
      ? "Nothing is ignored."
      : "No untracked files left in this list.";
    if (list.parentNode) list.parentNode.replaceChild(note, list);
  }

  function cardPaths(card) {
    var paths = [];
    var sel = card.querySelector("[data-field=logfile]");
    if (sel) {
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].value) paths.push(sel.options[i].value);
      }
    }
    var own = card.getAttribute("data-path") || "";
    if (own && paths.indexOf(own) < 0) paths.push(own);
    return paths;
  }

  function chosenLog(card) {
    var sel = card.querySelector("[data-field=logfile]");
    if (sel && sel.value) return sel.value;
    return card.getAttribute("data-path") || "";
  }

  function cardRetired(card) {
    var paths = cardPaths(card);
    for (var i = 0; i < paths.length; i++) {
      if (retired[paths[i]]) return true;
    }
    return false;
  }

  function dropRetired(root) {
    if (!root || !root.querySelectorAll) return;
    var nodes = root.querySelectorAll("[data-path]");
    for (var i = nodes.length - 1; i >= 0; i--) {
      if (cardRetired(nodes[i])) removeCard(nodes[i]);
    }
  }

  function refreshOpenList() {
    if (!latestMsg) {
      applyFilters();
      return;
    }
    var preserve = (view === "candidates" || view === "ignored") ? view : "";
    installBoard(latestMsg.html, preserve);
    if (latestMsg.generated_at) {
      document.body.setAttribute("data-generated-at", latestMsg.generated_at);
    }
    link = "up";
    refreshLive();
    applyFilters();
  }

  function setAction(text, bad) {
    if (!actionStatus) return;
    actionStatus.textContent = text || "";
    actionStatus.className = bad ? "note bad" : "note";
  }

  function postJSON(url, body) {
    return fetch(url, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-Requested-With": "syslog-gomonitor"
      },
      body: JSON.stringify(body)
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (!res.ok) throw new Error((data && data.error) || "The inventory could not be updated.");
        return data;
      });
    });
  }

  function field(card, name) {
    var el = card.querySelector('[data-field="' + name + '"]');
    return el ? el.value.trim() : "";
  }

  function clearMarks(card) {
    card.classList.remove("result-adopted", "result-ignored", "result-error");
    var marked = card.querySelectorAll(".invalid");
    for (var i = 0; i < marked.length; i++) marked[i].classList.remove("invalid");
  }

  function markFields(card, names) {
    for (var i = 0; i < names.length; i++) {
      var el = card.querySelector('[data-field="' + names[i] + '"]');
      if (el) el.classList.add("invalid");
    }
  }

  function choiceNote(card, text) {
    var note = card.querySelector(".choice-note");
    if (!note) {
      note = document.createElement("p");
      note.className = "choice-note";
      card.insertBefore(note, card.firstChild);
    }
    note.textContent = text;
  }

  function showChoice(card, kind) {
    card.classList.remove("result-adopted", "result-ignored", "result-error");
    if (kind === "ignore") card.classList.add("result-ignored");
    else if (kind === "error") card.classList.add("result-error");
    else card.classList.add("result-adopted");
  }

  function rejectInput(card, message, names) {
    clearMarks(card);
    showChoice(card, "error");
    markFields(card, names);
    choiceNote(card, message);
    setAction(message, true);
  }

  function finishCard(card, kind) {
    showChoice(card, kind);
    choiceNote(card, kind === "ignore" ? "Ignored" : "Adopted");
    var controls = card.querySelectorAll("button, input, select");
    for (var i = 0; i < controls.length; i++) controls[i].disabled = true;
    var paths = cardPaths(card);
    for (var i = 0; i < paths.length; i++) retired[paths[i]] = true;
    setTimeout(function () {
      dropRetired(board);
    }, 900);
  }

  function postEach(url, bodies) {
    var chain = Promise.resolve();
    bodies.forEach(function (body) {
      chain = chain.then(function () { return postJSON(url, body); });
    });
    return chain;
  }

  function runAction(btn) {
    if (busy) return;
    var card = btn.closest("[data-path]");
    if (!card || card.classList.contains("result-adopted") || card.classList.contains("result-ignored")) return;
    var action = btn.getAttribute("data-action");
    var logPath = chosenLog(card);
    var grouped = !!card.querySelector("[data-field=logfile]");
    var url = "/api/ignore";
    var done = grouped ? "Ignored this directory." : "Ignored this file.";
    var request;
    if (action === "unignore") {
      url = "/api/unignore";
      done = "This file can be adopted again.";
      request = postJSON(url, { log_path: logPath });
    } else if (action === "adopt") {
      var name = field(card, "name");
      var locked = card.getAttribute("data-ip-locked") === "true";
      var source = locked ? (card.getAttribute("data-source-ip") || "") : field(card, "source");
      var protocol = field(card, "protocol") || "udp";
      var port = field(card, "port");
      var bad = [];
      if (!name) bad.push("name");
      if (!locked && !source) bad.push("source");
      if (protocol === "tcp" && port) {
        var portNumber = Number(port);
        if (!portNumber || portNumber < 1 || portNumber > 65535) bad.push("port");
      }
      if (bad.length) {
        rejectInput(card, bad[0] === "port"
          ? "TCP port must be from 1 to 65535."
          : "Fill in the highlighted fields before adopting.", bad);
        return;
      }
      var body = { name: name, source_ip: source, protocol: protocol, log_path: logPath };
      if (protocol === "tcp" && port) body.tcp_port = Number(port);
      url = "/api/adopt";
      done = "Adopted " + name + ".";
      request = postJSON(url, body);
    } else {
      var paths = cardPaths(card);
      var bodies = [];
      for (var i = 0; i < paths.length; i++) bodies.push({ log_path: paths[i] });
      request = postEach(url, bodies);
    }
    clearMarks(card);
    showChoice(card, action);
    choiceNote(card, action === "ignore" ? (grouped ? "Ignoring this directory" : "Ignoring this file") : action === "unignore" ? "Returning this file" : "Adopting this device");
    busy = true;
    btn.disabled = true;
    setAction("Saving…", false);
    request.then(function () {
      setAction(done, false);
      finishCard(card, action);
    }).catch(function (err) {
      var message = err.message || "The inventory could not be updated.";
      showChoice(card, "error");
      choiceNote(card, message);
      setAction(message, true);
      if (btn.isConnected) btn.disabled = false;
    }).then(function () {
      busy = false;
    });
  }

  function apply(msg) {
    if (!msg || typeof msg.html !== "string") {
      return;
    }
    latestMsg = msg;
    refreshOpenList();
    if (detail && detail.open) loadDetail(false);
  }

  var kindLabel = {
    active: "Active",
    series: "Same series",
    rotation: "Rotation",
    other: "Other",
    symlink: "Symlink",
    directory: "Directory"
  };

  function detailLine(grid, label, value) {
    var dt = document.createElement("dt");
    dt.textContent = label;
    var dd = document.createElement("dd");
    dd.textContent = value || "—";
    grid.appendChild(dt);
    grid.appendChild(dd);
  }

  function renderDetail(data) {
    if (!data || data.source_ip !== openSource) return;
    detailTitle.textContent = data.name || "Device";
    detailBody.replaceChildren();
    var status = document.createElement("p");
    var pill = document.createElement("span");
    pill.className = "pill " + (data.status_class || "");
    pill.textContent = data.status || "Unknown";
    status.appendChild(pill);
    detailBody.appendChild(status);
    var grid = document.createElement("dl");
    grid.className = "detail-grid";
    detailLine(grid, "Source", data.source_ip);
    detailLine(grid, "Reporting", data.transport);
    detailLine(grid, "Silence limit", data.silence);
    detailLine(grid, "Log", (data.log_label || "") + (data.log_detail ? " — " + data.log_detail : ""));
    detailLine(grid, "Connection", data.connection);
    detailLine(grid, "Active file", data.log_path);
    detailLine(grid, "Last write", data.last_write);
    detailLine(grid, "Active size", data.active);
    detailLine(grid, "Stored logs", (data.stored || "") + (data.stored_detail ? " — " + data.stored_detail : ""));
    detailLine(grid, "Directory", data.directory);
    detailBody.appendChild(grid);
    var heading = document.createElement("h3");
    heading.textContent = "Files in this directory";
    detailBody.appendChild(heading);
    if (data.note) {
      var note = document.createElement("p");
      note.className = "note";
      note.textContent = data.note;
      detailBody.appendChild(note);
    }
    var files = data.files || [];
    if (!files.length) {
      var empty = document.createElement("p");
      empty.className = "note";
      empty.textContent = "No files in this directory.";
      detailBody.appendChild(empty);
    } else {
      var table = document.createElement("table");
      table.className = "detail-files";
      var head = document.createElement("thead");
      var hr = document.createElement("tr");
      ["File", "Kind", "Size", "Last write"].forEach(function (text) {
        var th = document.createElement("th");
        th.scope = "col";
        th.textContent = text;
        hr.appendChild(th);
      });
      head.appendChild(hr);
      table.appendChild(head);
      var body = document.createElement("tbody");
      files.forEach(function (file) {
        var tr = document.createElement("tr");
        [file.name, kindLabel[file.kind] || file.kind || "Other", file.size, file.when].forEach(function (text, index) {
          var td = document.createElement("td");
          if (index === 0) td.className = "path";
          if (index === 1) td.className = "kind " + (file.kind || "");
          td.textContent = text || "—";
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });
      table.appendChild(body);
      detailBody.appendChild(table);
    }
    var foot = document.createElement("p");
    foot.className = "note";
    foot.textContent = "Names and sizes only. Log contents are not read.";
    detailBody.appendChild(foot);
  }

  function loadDetail(force) {
    if (!detail || !detail.open || !openSource) return;
    var now = Date.now();
    if (!force && detailLoadedAt && now - detailLoadedAt < 5000) return;
    detailLoadedAt = now;
    var token = ++detailToken;
    var ip = openSource;
    fetch("/api/device?source_ip=" + encodeURIComponent(ip)).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (!res.ok) throw new Error((data && data.error) || "The device detail could not be loaded.");
        return data;
      });
    }).then(function (data) {
      if (token !== detailToken) return;
      renderDetail(data);
    }).catch(function (err) {
      if (token !== detailToken || ip !== openSource) return;
      detailTitle.textContent = "Device";
      detailBody.replaceChildren();
      var note = document.createElement("p");
      note.className = "note bad";
      note.textContent = err.message || "The device detail could not be loaded.";
      detailBody.appendChild(note);
    });
  }

  function openDetail(ip) {
    if (!detail || !ip) return;
    openSource = ip;
    detailTitle.textContent = "Device";
    detailBody.replaceChildren();
    var note = document.createElement("p");
    note.className = "note";
    note.textContent = "Reading the log directory…";
    detailBody.appendChild(note);
    if (!detail.open) detail.showModal();
    detailLoadedAt = 0;
    loadDetail(true);
  }

  board.addEventListener("change", function (ev) {
    var sel = ev.target;
    if (!sel || sel.getAttribute("data-field") !== "logfile") return;
    var card = sel.closest && sel.closest("[data-path]");
    var meta = card && card.querySelector("[data-file-meta]");
    var opt = sel.options[sel.selectedIndex];
    if (meta && opt) meta.textContent = opt.getAttribute("data-meta") || "";
  });

  board.addEventListener("input", function (ev) {
    var card = ev.target.closest && ev.target.closest("[data-path]");
    if (!card || !board.contains(card)) return;
    ev.target.classList.remove("invalid");
    if (!card.querySelector(".invalid")) card.classList.remove("result-error");
  });

  board.addEventListener("keydown", function (ev) {
    if (ev.key !== "Enter" && ev.key !== " ") return;
    var row = ev.target && ev.target.closest && ev.target.closest("tr.row");
    if (!row || ev.target !== row || !board.contains(row)) return;
    ev.preventDefault();
    openDetail(row.getAttribute("data-source"));
  });

  if (detailClose) detailClose.addEventListener("click", function () { detail.close(); });
  if (detail) {
    detail.addEventListener("close", function () { openSource = ""; detailToken++; detailLoadedAt = 0; });
    detail.addEventListener("click", function (ev) {
      if (ev.target === detail) detail.close();
    });
  }

  board.addEventListener("click", function (ev) {
    var row = ev.target.closest && ev.target.closest("tr.row");
    if (row && board.contains(row) && !ev.target.closest("a, button, input, select")) {
      openDetail(row.getAttribute("data-source"));
      return;
    }
    var action = ev.target.closest("[data-action]");
    if (action && board.contains(action)) {
      runAction(action);
      return;
    }
    var viewCard = ev.target.closest("[data-view]");
    if (viewCard && board.contains(viewCard)) {
      var chosen = viewCard.getAttribute("data-view");
      if (chosen === view) view = "";
      else {
        view = chosen;
        statusFilter = "";
      }
      refreshOpenList();
      return;
    }
    var card = ev.target.closest("[data-filter]");
    if (!card || !board.contains(card)) return;
    view = "";
    var next = card.getAttribute("data-filter");
    if (next === "all" || next === statusFilter) statusFilter = "";
    else statusFilter = next;
    refreshOpenList();
  });
  if (search) search.addEventListener("input", applyFilters);

  function connect() {
    if (!window.EventSource) {
      link = "down";
      refreshLive();
      return;
    }
    var source = new EventSource("/events");
    source.onmessage = function (ev) {
      try {
        apply(JSON.parse(ev.data));
      } catch (err) {
        link = "down";
        live.className = "live bad";
        liveText.textContent = "Status update was unreadable";
      }
    };
    source.onerror = function () {
      link = "down";
      refreshLive();
    };
  }

  var themeBrowser = document.getElementById("theme-browser");
  var themeLight = document.getElementById("theme-light");
  var themeDark = document.getElementById("theme-dark");
  var backToTop = document.getElementById("back-to-top");

  function paintTheme(theme) {
    var explicit = theme === "light" || theme === "dark";
    if (explicit) document.documentElement.setAttribute("data-theme", theme);
    else document.documentElement.removeAttribute("data-theme");
    if (themeBrowser) themeBrowser.setAttribute("aria-pressed", explicit ? "false" : "true");
    if (themeLight) themeLight.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
    if (themeDark) themeDark.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
  }

  function chooseTheme(theme) {
    try {
      if (theme === "browser") localStorage.removeItem("syslog-gomonitor-theme");
      else localStorage.setItem("syslog-gomonitor-theme", theme);
    } catch (err) {}
    paintTheme(theme === "browser" ? "" : theme);
  }

  paintTheme(document.documentElement.getAttribute("data-theme") || "");
  if (themeBrowser) themeBrowser.addEventListener("click", function () { chooseTheme("browser"); });
  if (themeLight) themeLight.addEventListener("click", function () { chooseTheme("light"); });
  if (themeDark) themeDark.addEventListener("click", function () { chooseTheme("dark"); });

  function syncBackToTop() {
    if (!backToTop) return;
    backToTop.hidden = window.scrollY < 320;
  }
  if (backToTop) {
    backToTop.addEventListener("click", function () {
      var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
    window.addEventListener("scroll", syncBackToTop);
    syncBackToTop();
  }

  refreshLive();
  applyFilters();
  setInterval(refreshLive, 5000);
  connect();
})();
</script>
</body>
</html>
